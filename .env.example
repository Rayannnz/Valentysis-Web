# Copy to .env.local and fill in. .env.local is gitignored — never commit real credentials.
# Restart the dev server after changing these; Next reads env at boot.

# --- SMTP credentials for the /contact form -------------------------------
# Use the mailbox host for sales@valentisys.com. Examples:
#   Google Workspace  smtp.gmail.com        port 587  (needs an App Password, not the login password)
#   Microsoft 365     smtp.office365.com    port 587
#   Zoho              smtp.zoho.com         port 465
#   cPanel / shared   mail.valentisys.com   port 465
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to true when SMTP_PORT is 465, false otherwise.
# SMTP_SECURE=false

# --- Where enquiries land -------------------------------------------------
# Optional. Defaults to sales@valentisys.com.
# CONTACT_TO=sales@valentisys.com
# Optional. Defaults to "Valentisys website" <SMTP_USER>.
# Many providers reject a From address that isn't the authenticated mailbox.
# CONTACT_FROM="Valentisys website" <sales@valentisys.com>
